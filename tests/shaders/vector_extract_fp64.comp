#version 450
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) buffer DoubleBuffer
{
    dvec4 values[];
} double_buffer;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint index = i & 3u;
    double_buffer.values[i][index] = double_buffer.values[i][(index + 1u) & 3u] + 1.0;
}
