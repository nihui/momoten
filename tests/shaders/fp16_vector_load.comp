#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 1) in;
layout(binding = 0) readonly buffer Input { f16vec4 data[]; } input_buffer;
layout(binding = 1) volatile readonly buffer VolatileInput { f16vec4 data[]; } volatile_buffer;
layout(binding = 2) readonly buffer Tail { f16vec4 data[]; } tail;
layout(binding = 3) writeonly buffer Output { f16vec4 data[]; } output_buffer;

void main()
{
    f16vec4 lanes = input_buffer.data[0];
    output_buffer.data[0] = lanes.wzyx;
    output_buffer.data[1] = volatile_buffer.data[0];
    output_buffer.data[2] = f16vec4(tail.data[0].z);

    // Dynamic private components must preserve NaN payloads, signed zero and
    // subnormals just like the original buffer loads and stores.
    for (uint lane = 0u; lane < 4u; lane++)
    {
        float16_t previous = lanes[lane];
        lanes[lane] = volatile_buffer.data[0][lane];
        output_buffer.data[3][lane] = previous;
    }
    output_buffer.data[4] = lanes;
}
