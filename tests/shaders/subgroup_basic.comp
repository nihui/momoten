#version 450
#extension GL_KHR_shader_subgroup_basic : require

layout(local_size_x = 4, local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) writeonly buffer Output
{
    uint values[];
} output_data;

void main()
{
    uint value = gl_SubgroupSize;
    value += gl_SubgroupInvocationID * 10u;
    value += gl_SubgroupID * 100u;
    value += gl_NumSubgroups * 1000u;
    if (subgroupElect())
        value += 10000u;
    subgroupMemoryBarrierBuffer();
    subgroupBarrier();
    // Four samples per workgroup cover both sides of the midpoint and the
    // final invocation. At the default size of four, every invocation writes.
    uint lane = gl_LocalInvocationID.x;
    uint midpoint = gl_WorkGroupSize.x / 2u;
    uint sample_index;
    if (lane == 0u)
        sample_index = 0u;
    else if (lane + 1u == midpoint)
        sample_index = 1u;
    else if (lane == midpoint)
        sample_index = 2u;
    else if (lane + 1u == gl_WorkGroupSize.x)
        sample_index = 3u;
    else
        return;
    output_data.values[gl_WorkGroupID.x * 4u + sample_index] = value;
}
