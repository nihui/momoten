#version 450

layout(local_size_x = 1) in;
layout(binding = 0) writeonly buffer Pairs { vec2 data[]; } pairs;
layout(binding = 1) writeonly buffer Quads { vec4 data[]; } quads;
layout(binding = 2) volatile writeonly buffer VolatileQuads { vec4 data[]; } volatile_quads;
layout(binding = 3) writeonly buffer Tail { vec4 data[]; } tail;
layout(binding = 4) buffer PartialQuads { vec4 data[]; } partial_quads;

void main()
{
    if (gl_GlobalInvocationID.x != 0)
        return;
    pairs.data[0] = vec2(1, 2);
    quads.data[0] = vec4(3, 4, 5, 6);
    volatile_quads.data[0] = vec4(7, 8, 9, 10);
    tail.data[0].z = 11;
    partial_quads.data[0].xyz = vec3(12, 13, 14);
}
