#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer S
{
    int8_t values[];
} s;
layout(set = 0, binding = 1, std430) readonly buffer S2
{
    i8vec2 values[];
} s2;
layout(set = 0, binding = 2, std430) readonly buffer S4
{
    i8vec4 values[];
} s4;
layout(set = 0, binding = 3, std430) readonly buffer U
{
    uint8_t values[];
} u;
layout(set = 0, binding = 4, std430) readonly buffer U2
{
    u8vec2 values[];
} u2;
layout(set = 0, binding = 5, std430) readonly buffer U4
{
    u8vec4 values[];
} u4;
layout(set = 0, binding = 6, std430) writeonly buffer Output
{
    uint values[];
} output_data;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= 65536u)
        return;
    ivec2 result_s2 = ivec2(i16vec2(s2.values[i]));
    ivec4 result_s4 = ivec4(i16vec4(s4.values[i]));
    uvec2 result_u2 = uvec2(u16vec2(u2.values[i]));
    uvec4 result_u4 = uvec4(u16vec4(u4.values[i]));
    output_data.values[i * 14u] = uint(int(int16_t(s.values[i])));
    output_data.values[i * 14u + 7u] = uint(uint16_t(u.values[i]));
    for (uint lane = 0; lane < 2; lane++)
    {
        output_data.values[i * 14u + 1u + lane] = uint(result_s2[lane]);
        output_data.values[i * 14u + 8u + lane] = result_u2[lane];
    }
    for (uint lane = 0; lane < 4; lane++)
    {
        output_data.values[i * 14u + 3u + lane] = uint(result_s4[lane]);
        output_data.values[i * 14u + 10u + lane] = result_u4[lane];
    }
}
