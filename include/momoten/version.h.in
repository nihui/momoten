#ifndef MOMOTEN_VERSION_H
#define MOMOTEN_VERSION_H

#define MOMOTEN_VERSION_MAJOR @MOMOTEN_VERSION_MAJOR@
#define MOMOTEN_VERSION_MINOR @MOMOTEN_VERSION_MINOR@
#define MOMOTEN_VERSION_PATCH @MOMOTEN_VERSION_PATCH@
#define MOMOTEN_VERSION_STRING "@MOMOTEN_VERSION@"

// Distribution date and its Vulkan-compatible (year - 2000).month.day encoding.
#define MOMOTEN_RELEASE_VERSION @MOMOTEN_RELEASE_VERSION@u
#define MOMOTEN_RELEASE_VERSION_STRING "@MOMOTEN_RELEASE_VERSION@"
#define MOMOTEN_DRIVER_VERSION_MAJOR @MOMOTEN_DRIVER_VERSION_MAJOR@
#define MOMOTEN_DRIVER_VERSION_MINOR @MOMOTEN_DRIVER_VERSION_MINOR@
#define MOMOTEN_DRIVER_VERSION_PATCH @MOMOTEN_DRIVER_VERSION_PATCH@

#endif // MOMOTEN_VERSION_H
