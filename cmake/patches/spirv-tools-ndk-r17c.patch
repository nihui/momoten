 namespace spvtools {
 
+namespace {
+
+// NDK r17c has no <charconv>. Match from_chars for unsigned decimal values:
+// reject signs/whitespace, stop at the first non-digit, and detect overflow.
+struct ParseUInt32Result {
+  const char* ptr;
+  std::errc ec;
+};
+
+ParseUInt32Result ParseUInt32(const char* first, const char* last,
+                             uint32_t& value) {
+  if (first == last || *first < '0' || *first > '9')
+    return {first, std::errc::invalid_argument};
+
+  uint32_t result = 0;
+  const char* ptr = first;
+  while (ptr != last && *ptr >= '0' && *ptr <= '9') {
+    const uint32_t digit = static_cast<uint32_t>(*ptr - '0');
+    if (result > (std::numeric_limits<uint32_t>::max() - digit) / 10)
+      return {ptr, std::errc::result_out_of_range};
+    result = result * 10 + digit;
+    ++ptr;
+  }
+  value = result;
+  return {ptr, std::errc()};
+}
+
+}  // namespace
